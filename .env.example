# Copy this file to .env for local `netlify dev` testing (never commit .env).
# In production, set these as real environment variables in the Netlify
# dashboard: Site settings -> Environment variables.

# Stripe secret key — used only server-side by netlify/functions/create-checkout-session.js
STRIPE_SECRET_KEY=sk_test_...

# Recurring (monthly) Price IDs from Stripe Dashboard > Products
STRIPE_PRICE_ESSENCIAL=price_...
STRIPE_PRICE_REDE=price_...
